# Application
APP_PORT=8080

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=taskuser
DB_PASSWORD=taskpass
DB_NAME=taskdb
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379

# Auth (required, use a long random value)
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=24h

# Cache
CACHE_TTL=5m

# Rate limiting
RATE_LIMIT_AUTH_RPM=10

# Circuit breaker (Redis)
CB_MAX_REQUESTS=1
CB_INTERVAL=30s
CB_TIMEOUT=10s
